// ----------------------------------------------------------------------------
// КРОК 1. Топ-20 вузлів за ступенем (кількістю інцидентних ребер).
// COUNT { (n)--() } — підрахунок усіх ребер вузла (будь-який тип/напрям).
// coalesce(...) дає людську назву незалежно від лейбла (Movie.title / Genre.name
// / User.userId).
// ----------------------------------------------------------------------------
MATCH (n)
WITH n, COUNT { (n)--() } AS degree
RETURN labels(n)                                   AS labels,
       coalesce(n.title, n.name, toString(n.userId)) AS node,
       degree
ORDER BY degree DESC
LIMIT 20;


// ----------------------------------------------------------------------------
// КРОК 2. Розподіл ступеня ПО ЛЕЙБЛАХ: max / середнє / 99-й перцентиль.
// Показує, що супервузли — це не лише окремі фільми, а й ЦІЛИЙ КЛАС вузлів Genre.
// ----------------------------------------------------------------------------
MATCH (n)
WITH n, COUNT { (n)--() } AS degree
RETURN labels(n)[0]                  AS label,
       count(*)                      AS nodes,
       max(degree)                   AS maxDegree,
       round(avg(degree), 1)         AS avgDegree,
       round(percentileCont(degree, 0.99), 0) AS p99Degree
ORDER BY maxDegree DESC;


// ----------------------------------------------------------------------------
// КРОК 3. Жанрові вузли — окремо: скільки фільмів «висить» на кожному жанрі.
// Кожен Genre — це супервузол-хаб (сотні–тисячі ребер HAS_GENRE).
// ----------------------------------------------------------------------------
MATCH (g:Genre)
RETURN g.name AS genre, COUNT { (g)<-[:HAS_GENRE]-() } AS movies
ORDER BY movies DESC;


// ----------------------------------------------------------------------------
// КРОК 4 (демонстрація проблеми). Найрейтинговіші фільми = супервузли по RATED.
// Саме такі вузли роблять обхід «через спільний фільм» дорогим (див. README).
// ----------------------------------------------------------------------------
MATCH (m:Movie)
WITH m, COUNT { (m)<-[:RATED]-() } AS ratings
RETURN m.title AS movie, m.year AS year, ratings
ORDER BY ratings DESC
LIMIT 10;
